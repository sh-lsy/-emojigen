# Server-side fallback (optional).
# When the UI does not provide a key, the API will use these.
# For personal deployments only — leaving these unset will simply require
# users to provide their own key in the in-app settings dialog.

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMOJIGEN_MODEL=gpt-4o-mini
